<IfModule mod_rewrite.c>
    RewriteEngine On

    # La landing tiene marcadores ({{acceso_texto}}, etc.) que solo reemplaza PHP:
    # si alguien abre el HTML directo, se lo manda a "/".
    RewriteRule ^front/index\.html$ / [R=302,L]

    # Solo se permite acceso a:
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_URI} !^/(api|front)(/|$)
    RewriteCond %{REQUEST_URI} !^/(login|logout|dash)(/|$)
    RewriteCond %{REQUEST_URI} !^/\.well-known(/|$)
    RewriteRule ^ - [R=404,L]

    # ====================================================
    # 1. TRÁFICO DE LA API (Los repartidores)
    # ====================================================
    # Si la URL solicitada empieza con "api/"...
    RewriteCond %{REQUEST_URI} ^/api/
    # ...y no es un archivo físico que exista (como una imagen)...
    RewriteCond %{REQUEST_FILENAME} !-f
    # ...y tampoco es una carpeta real...
    RewriteCond %{REQUEST_FILENAME} !-d
    # ...entonces, manda TODO al index.php de la carpeta api.
    RewriteRule ^api/(.*)$ /api/index.php [L,QSA]

    # ====================================================
    # 2. PÁGINAS CON SESIÓN (las decide el AuthController)
    # ====================================================
    # /login, /logout, /dash, /dash/admin, /dash/admin/registrar, ...
    # van al index.php de la API, que mira la sesión y decide qué mostrar.
    RewriteRule ^(login|logout|dash)(/.*)?$ /api/index.php [L,QSA]
    
    # ====================================================
    # 3. LANDING (pasa por PHP para poder usar la sesión)
    # ====================================================
    RewriteRule ^$ /api/index.php [L,QSA]
</IfModule>
