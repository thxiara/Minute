<IfModule mod_rewrite.c>
    RewriteEngine On

    # ====================================================
    # 1. TRÁFICO DE LA API (Los repartidores)
    # ====================================================
    # Si la URL solicitada empieza con "api/"...
    RewriteCond %{REQUEST_URI} ^/api/
    # ...y no es un archivo físico que exista (como una imagen)...
    RewriteCond %{REQUEST_FILENAME} !-f
    # ...y tampoco es una carpeta real...
    RewriteCond %{REQUEST_FILENAME} !-d
    # ...entonces, manda TODO al index.php de la carpeta api.
    RewriteRule ^api/(.*)$ /api/index.php [L,QSA]

    # ====================================================
    # 2. PÁGINAS CON SESIÓN (las decide el AuthController)
    # ====================================================
    # /login, /logout, /dash, /dash/admin, /dash/admin/registrar, ...
    # van al index.php de la API, que mira la sesión y decide qué mostrar.
    RewriteRule ^(login|logout|dash)(/.*)?$ /api/index.php [L,QSA]
    
    # ====================================================
    # 3. PÁGINAS PÚBLICAS (URL linda → archivo real)
    # ====================================================
    # Sin [R]: el navegador sigue viendo la URL linda, Apache sirve el archivo por detrás.
    RewriteRule ^$ /front/index.html [L]
    # RewriteRule ^resenas/?$ /front/dist/paginas/resenas.html [L]
    # RewriteRule ^pagar/?$ /front/dist/paginas/pagar.html [L]
</IfModule>